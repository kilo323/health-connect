# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# LLM Configuration for vision capable LLM to read documents
# and get metrics from them
LLM_API_TOKEN=your-provider-token-here
LLM_URL=https://your-provider.com/v1
LLM_MODEL=your-model-name
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# LLM configuration for the metric normalization process
# If left unset, it will fallback to the default LLM above
METRIC_LLM_URL=https://your-provider.com/v1
METRIC_LLM_API_TOKEN=your-token
METRIC_LLM_MODEL=your-model

# Set to false to skip SSL certificate verification on LLM API calls
# (e.g. behind a corporate TLS-inspecting proxy). Defaults to true.
# LLM_SSL_VERIFY=false

# Encryption key for stored secrets (OAuth tokens, Nextcloud creds)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
#FERNET_KEY=

# Protect hand-tuned metric definitions (the Google Health entries marked
# "protected": true) from being overwritten by refresh_metric_library.py and
# the startup library seed. Default true. Set to 0/false to allow overwrites.
#METRIC_LIBRARY_PROTECT=true

# When migrating to publicly available URL
# you can setup a subscription in 3 steps
# - Deploy at a public HTTPS URL (or tunnel for dev)
# - Create the service account + google-auth install, set WEBHOOK_SECRET and GOOGLE_CLOUD_PROJECT_NUMBER env vars
# - Run register_google_health_subscriber.py --project-number N --endpoint https://your-domain/api/webhooks/google-health --secret "
#WEBHOOK_SECRET=
#GOOGLE_CLOUD_PROJECT_NUMBER=