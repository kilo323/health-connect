# ── Development Dockerfile ──
# Single container with both Python and Node.js for live reload.
# Usage: docker compose -f docker-compose.dev.yml up --build

FROM node:22-slim

# Pin npm to the latest stable major version to avoid warnings and ensure reproducible installs
RUN npm install -g npm@12

# Install Python 3.12 + pip (needed for uvicorn backend)
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip python3-venv curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Symlink python3 → python for convenience
RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Install Python dependencies first (cached layer)
COPY app/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --break-system-packages -r /app/requirements.txt

# Install Node dependencies (cached layer)
COPY app/frontend/package.json app/frontend/package-lock.json* /app/frontend/
WORKDIR /app/frontend
RUN npm install

WORKDIR /app

EXPOSE 3000 8000

CMD ["bash", "/app/start-dev.sh"]
